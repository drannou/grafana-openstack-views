{
  "title": "OpenStack Nova - Usage théorique des hosts par aggregat",
  "uid": "nova-hosts-theoretical-usage",
  "tags": ["openstack", "nova", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "aggregate",
        "type": "query",
        "label": "Aggregat",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "qryType": 1,
          "query": "label_values(openstack_nova_vcpus_available, aggregates)",
          "refId": "aggregate-variable"
        },
        "definition": "label_values(openstack_nova_vcpus_available, aggregates)",
        "sort": 1,
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "hostname",
        "type": "query",
        "label": "Host",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "qryType": 1,
          "query": "label_values(openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"}, hostname)",
          "refId": "hostname-variable"
        },
        "definition": "label_values(openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"}, hostname)",
        "sort": 1,
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Aggregat : $aggregate",
      "repeat": "aggregate",
      "repeatDirection": "v",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Hosts",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"})",
          "legendFormat": "Hosts",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "RAM moyenne",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(100 * openstack_nova_memory_used_bytes{aggregates=~\".*$aggregate.*\"} / openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"} and openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"} > 0)",
          "legendFormat": "RAM moyenne",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "CPU moyen",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(100 * openstack_nova_vcpus_used{aggregates=~\".*$aggregate.*\"} / openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"} and openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"} > 0)",
          "legendFormat": "CPU moyen",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "VMs",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(openstack_nova_running_vms{aggregates=~\".*$aggregate.*\"})",
          "legendFormat": "VMs",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "${hostname}",
      "repeat": "hostname",
      "repeatDirection": "h",
      "maxPerRow": 10,
      "gridPos": { "h": 6, "w": 3, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * openstack_nova_memory_used_bytes{hostname=~\"^$hostname$\"} / openstack_nova_memory_available_bytes{hostname=~\"^$hostname$\"}",
          "legendFormat": "RAM %",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * openstack_nova_vcpus_used{hostname=~\"^$hostname$\"} / openstack_nova_vcpus_available{hostname=~\"^$hostname$\"}",
          "legendFormat": "CPU %",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "openstack_nova_agent_state{service=\"nova-compute\", hostname=~\"^$hostname$\", adminState=\"disabled\"} * 0 + 1",
          "legendFormat": "⚠ DISABLED",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 10,
        "minVizWidth": 0,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "⚠ DISABLED" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "red", "value": null }]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": { "1": { "text": "⚠ DISABLED", "color": "red", "index": 0 } }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
