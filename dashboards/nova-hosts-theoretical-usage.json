{
  "title": "OpenStack Nova - Usage théorique des hosts par aggregat",
  "uid": "nova-hosts-theoretical-usage",
  "tags": ["openstack", "nova", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "aggregate",
        "type": "query",
        "label": "Aggregat",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "qryType": 1,
          "query": "label_values(openstack_nova_vcpus_available, aggregates)",
          "refId": "aggregate-variable"
        },
        "definition": "label_values(openstack_nova_vcpus_available, aggregates)",
        "sort": 1,
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 40,
      "type": "row",
      "title": "Vue d'ensemble",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 41,
      "type": "stat",
      "title": "${aggregate}",
      "repeat": "aggregate",
      "repeatDirection": "h",
      "maxPerRow": 8,
      "gridPos": { "h": 7, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"})",
          "legendFormat": "Hosts",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(openstack_nova_agent_state{service=\"nova-compute\", adminState=\"disabled\"} and on(hostname) openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"}) or vector(0)",
          "legendFormat": "Disabled",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(100 * openstack_nova_memory_used_bytes{aggregates=~\".*$aggregate.*\"} / openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"} and openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"} > 0)",
          "legendFormat": "RAM %",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(100 * openstack_nova_vcpus_used{aggregates=~\".*$aggregate.*\"} / openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"} and openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"} > 0)",
          "legendFormat": "CPU %",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(openstack_nova_running_vms{aggregates=~\".*$aggregate.*\"})",
          "legendFormat": "VMs",
          "instant": true
        }
      ],
      "options": {
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hosts" },
            "properties": [
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disabled" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "VMs" },
            "properties": [
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "RAM %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 80 },
                    { "color": "red", "value": 100 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 80 },
                    { "color": "red", "value": 100 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "Aggregat : $aggregate",
      "repeat": "aggregate",
      "repeatDirection": "v",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Hosts",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"})",
          "legendFormat": "Hosts",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "RAM moyenne",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(100 * openstack_nova_memory_used_bytes{aggregates=~\".*$aggregate.*\"} / openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"} and openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"} > 0)",
          "legendFormat": "RAM moyenne",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "CPU moyen",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(100 * openstack_nova_vcpus_used{aggregates=~\".*$aggregate.*\"} / openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"} and openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"} > 0)",
          "legendFormat": "CPU moyen",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "VMs",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(openstack_nova_running_vms{aggregates=~\".*$aggregate.*\"})",
          "legendFormat": "VMs",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Hosts de l'aggregat",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * openstack_nova_memory_used_bytes{aggregates=~\".*$aggregate.*\"} / openstack_nova_memory_available_bytes{aggregates=~\".*$aggregate.*\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * openstack_nova_vcpus_used{aggregates=~\".*$aggregate.*\"} / openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(openstack_nova_agent_state{service=\"nova-compute\", adminState=\"disabled\"} and on(hostname) openstack_nova_vcpus_available{aggregates=~\".*$aggregate.*\"}, \"disabledReason\", \"DISABLED\", \"disabledReason\", \"^$\")",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "id": true,
              "availability_zone": true,
              "aggregates": true,
              "service": true,
              "adminState": true,
              "Value #C": true
            },
            "renameByName": {
              "hostname": "Host",
              "Value #A": "RAM %",
              "Value #B": "CPU %",
              "disabledReason": "Statut"
            },
            "indexByName": { "hostname": 0, "Value #A": 1, "Value #B": 2, "disabledReason": 3 }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "RAM %", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "RAM %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 80 },
                    { "color": "red", "value": 100 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 80 },
                    { "color": "red", "value": 100 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Statut" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "special", "options": { "match": "null", "result": { "text": "OK", "color": "green" } } },
                  { "type": "value", "options": { "": { "text": "OK", "color": "green" } } }
                ]
              },
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
              }
            ]
          }
        ]
      }
    }
  ]
}
